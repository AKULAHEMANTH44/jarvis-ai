# ==============================================================================
# JARVIS AI — SERVER ENVIRONMENT CONFIGURATION
# Copy to .env or set environment variables in your deployment / runtime host.
# NEVER commit real API keys or credentials.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Primary AI Provider — Google Gemini
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Fallback AI Provider — Groq
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# LLM Orchestrator Default Mode: AUTO | GEMINI_ONLY | GROQ_ONLY
DEFAULT_LLM_MODE=AUTO
